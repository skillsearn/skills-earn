NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# razorpay | mock   (mock is refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX account number (x.razorpay.com → Account details). Enables automatic withdrawal payouts.
# Uses the same RAZORPAY_KEY_ID / SECRET. Leave empty to pay withdrawals manually.
RAZORPAYX_ACCOUNT_NUMBER=
